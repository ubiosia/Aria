# .env.example — variables de entorno que usa ARIA (Fase 3, Punto 4)
#
# Copiá este archivo a .env y completá los valores reales que necesites.
# .env NUNCA se versiona (ver .gitignore) — ni siquiera con valores de
# ejemplo o truncados, siguiendo la misma disciplina de privacidad del
# resto de este repositorio.
#
# No todas las variables de abajo hacen falta para el core mínimo
# (arrancar_aria.sh / aria_core_minimo.py) — están marcadas cuáles sí.

# ---------------------------------------------------------------------
# Usadas por aria_core_minimo.py / config_dominios.py (código publicado
# en /codigo/) — confirmado revisando el código, no de memoria.
# ---------------------------------------------------------------------

# Carpeta base donde ARIA busca memoria_personal/, etc. Si no se
# define, memoria.py y auditar_decision.py usan ~/asistente por
# defecto (ver codigo/memoria.py y codigo/auditar_decision.py).
ARIA_BASE_DIR=

# Backend de memoria.py: "true" (default) usa SQLite; "false" vuelve al
# backend JSON original. Flag de emergencia — ver el docstring de
# codigo/memoria.py.
MEMORIA_SQL=true

# ---------------------------------------------------------------------
# Documentadas en /tecnico/configuracion.md — no usadas por el código
# publicado en /codigo/ (son del sistema completo, no del core mínimo).
# ---------------------------------------------------------------------

# Clave de API para el proveedor de inferencia en la nube (Groq), usada
# por el agente de trading cuando TRADING_MODE=CLOUD.
GROQ_API_KEY=

# Clave de API equivalente, usada por el agente de tecnología.
GROQ_API_KEY_TECNOLOGIA=

# Clave de API equivalente, usada por el agente de IA.
GROQ_API_KEY_IA=

# Controla si el agente de trading responde con el modelo local (RAG) o
# con el proveedor en la nube. Valores usados: LOCAL o CLOUD.
TRADING_MODE=LOCAL

# Desactiva el reconocimiento de voz cuando no hace falta (por ejemplo,
# en pruebas automatizadas).
ARIA_DISABLE_WHISPER=false

# Activa el descubrimiento automático de nuevas capacidades
# (skills/handlers) sin tener que registrarlas a mano.
ARIA_SKILLS_DISCOVERY=false

# ---------------------------------------------------------------------
# Nota sobre una advertencia real documentada en tecnico/configuracion.md
# ---------------------------------------------------------------------
# Una variable exportada en ~/.bashrc tiene prioridad sobre lo que diga
# este archivo .env en cada terminal nueva — y esa prioridad no es
# evidente a simple vista. Si una variable no toma el valor que
# esperás, revisá primero si hay una exportación duplicada en
# ~/.bashrc antes de asumir un bug en el código (caso real documentado
# con TRADING_MODE, ver tecnico/configuracion.md).
